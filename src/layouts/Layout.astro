---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const {
  title,
  description = "I'm Mohin. I'm vibe-coding my first SaaS using Claude Cowork. Build logs, tutorials, honest tool comparisons.",
  canonical,
} = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://mohinbuilds.pages.dev').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="mohinbuilds" href="/rss.xml" />
    <style is:global>
      :root {
        --max-width: 680px;
        --text: #1a1a1a;
        --muted: #666;
        --accent: #d35400;
        --bg: #fafafa;
      }
      * { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        color: var(--text);
        background: var(--bg);
        line-height: 1.65;
        font-size: 1.075rem;
      }
      header {
        margin-bottom: 3rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #ddd;
      }
      header a {
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.15rem;
      }
      h1 { font-size: 1.85rem; line-height: 1.25; margin: 1.5rem 0 0.5rem; }
      h2 { font-size: 1.35rem; margin: 2.25rem 0 0.5rem; }
      h3 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
      a { color: var(--accent); }
      a:hover { text-decoration: underline; }
      time { color: var(--muted); font-size: 0.9rem; }
      pre, code { font-family: "SF Mono", Menlo, monospace; font-size: 0.95rem; }
      pre {
        background: #f0f0f0;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
      }
      p code { background: #efefef; padding: 0.1rem 0.3rem; border-radius: 3px; }
      blockquote {
        border-left: 3px solid var(--accent);
        margin: 1rem 0;
        padding-left: 1rem;
        color: var(--muted);
      }
      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid #ddd;
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--muted); }
      ul.post-list { list-style: none; padding: 0; }
      ul.post-list li { margin: 0.75rem 0; display: flex; justify-content: space-between; gap: 1rem; }
      ul.post-list a { flex: 1; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">mohinbuilds</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Mohin · <a href="/about/">about</a> · <a href="/rss.xml">rss</a>
    </footer>
  </body>
</html>
