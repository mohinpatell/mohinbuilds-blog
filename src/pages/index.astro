---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---
<Layout title="mohinbuilds">
  <h1>I'm Mohin and I'm building things.</h1>
  <p>
    I'm a CS student vibe-coding my first SaaS using Claude Cowork. This is the build log:
    what I tried, what broke, and what I'd tell day-1 me. No course-selling.
  </p>

  <h2>Posts</h2>
  {posts.length === 0 ? (
    <p><em>First post coming soon.</em></p>
  ) : (
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
        </li>
      ))}
    </ul>
  )}
</Layout>
